/* The one stylesheet of the application. main.py applies it to the
   QApplication, so it reaches the main window, the dialog box and the
   error box. After editing it, run `just uic` to compile it into the
   resources.

   The colours:
     rgb(51,51,51)    title bar, menu, buttons and fields at rest
     rgb(91,90,90)    page background, hovered and selected menu buttons
     rgb(0,143,150)   accent: the toggle, hovered window and action buttons
     rgb(0,143,170)   accent: progress, slider and scroll handles, checked marks
     rgb(112,112,112) disabled
     rgb(112,0,0)     hovered delete button
*/

/* ---- Surfaces ---- */

#centralwidget,
QStackedWidget > QWidget,
#stackedWidget_android,
#frame_textbar,
QDialog #frame_top,
QDialog #frame_bottom {
    background: rgb(91,90,90);
}

#frame_top_east,
#frame_bottom_west,
#frame_android_menu,
#frame_tab,
#frame_drag,
#Dialog,
#Dialog #frame_2,
#Error #frame {
    background: rgb(51,51,51);
}

#frame_toodle {
    background: rgb(0,143,150);
}

/* Frames and lines on a page take the page colour, so that the outline Qt
   draws for a boxed frame or a separator line is shaded from it. The dot
   means QFrame itself, not the labels and other classes built on it. */
QStackedWidget .QFrame {
    background: rgb(91,90,90);
}

/* The frames around the menu buttons. ui_function.py sets `selected` to true
   on the one whose page is showing and to false on the rest. These rules
   come after the one above so that they win inside a page as well. */
QFrame[selected="false"] {
    background: rgb(51,51,51);
}
QFrame[selected="true"] {
    background: rgb(91,90,90);
}

/* ---- Text ---- */

QLabel {
    color: rgb(255,255,255);
}

QTextEdit {
    color: rgb(255,255,255);
    background: rgb(91,90,90);
}

/* ---- Push buttons ----
   A plain QPushButton is an action button (Start, Save, Connect, ...).
   The others say what they are with a `variant` property, set in Qt
   Designer as a dynamic property: menu, window or danger. */

QPushButton {
    border: 2px solid rgb(51,51,51);
    border-radius: 5px;
    color: rgb(255,255,255);
    background-color: rgb(51,51,51);
}
QPushButton:hover {
    border: 2px solid rgb(0,143,150);
    background-color: rgb(0,143,150);
}
QPushButton:pressed {
    border: 2px solid rgb(0,143,150);
    background-color: rgb(51,51,51);
}
QPushButton:disabled {
    border: 2px solid rgb(112,112,112);
    background-color: rgb(112,112,112);
}

QPushButton[variant="danger"]:hover {
    border: 2px solid rgb(112,0,0);
    background-color: rgb(112,0,0);
}
QPushButton[variant="danger"]:pressed {
    border: 2px solid rgb(112,0,0);
    background-color: rgb(51,51,51);
}

QPushButton[variant="menu"],
QPushButton[variant="window"],
#toodle {
    border: none;
    border-radius: 0;
    background-color: rgba(0,0,0,0);
}
QPushButton[variant="menu"]:hover {
    border: none;
    background-color: rgb(91,90,90);
}
QPushButton[variant="window"]:hover {
    border: none;
    background-color: rgb(0,143,150);
}
#toodle:hover {
    border: none;
    background-color: rgb(0,178,178);
}
/* Pressed comes after hover: a pressed button is hovered too, and the later
   rule wins. */
QPushButton[variant="menu"]:pressed,
QPushButton[variant="window"]:pressed,
#toodle:pressed {
    border: none;
    background-color: rgba(0,0,0,0);
}

/* The dialog box draws its window buttons on a lighter bar. */
QDialog QPushButton[variant="window"],
QDialog QPushButton[variant="window"]:pressed {
    background-color: rgb(51,51,51);
}

/* ---- The resize grip in the bottom right corner ---- */

QSizeGrip {
    image: url(:/icons/grip.png);
}

/* ---- Inputs and indicators ---- */

/* The list a combo box drops down. */
QComboBox QAbstractItemView {
    color: rgb(255,255,255);
    background: rgb(91,90,90);
}

QLineEdit {
    color: rgb(255,255,255);
    border: 2px solid rgb(51,51,51);
    border-radius: 4px;
    background: rgb(51,51,51);
}
QLineEdit:disabled {
    color: rgb(255,255,255);
    border: 2px solid rgb(112,112,112);
    border-radius: 4px;
    background: rgb(112,112,112);
}

QComboBox {
    border: 2px solid rgb(51,51,51);
    border-radius: 5px;
    color: rgb(255,255,255);
    background-color: rgb(51,51,51);
}
QComboBox:hover {
    border: 2px solid rgb(0,143,170);
    border-radius: 5px;
    color: rgb(255,255,255);
    background-color: rgb(0,143,170);
}
QComboBox:!editable, QComboBox::drop-down:editable {
    background: rgb(51,51,51);
}
QComboBox:!editable:on, QComboBox::drop-down:editable:on {
    background: rgb(51,51,51);
}
QComboBox:on {
    padding-top: 3px;
    padding-left: 4px;
}
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 15px;
    border-left-width: 1px;
    border-left-color: darkgray;
    border-left-style: solid;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
}
QComboBox::down-arrow {
    image: url(:/icons/dropdown.png);
}
QComboBox::down-arrow:on {
    top: 1px;
    left: 1px;
}
QComboBox::drop-down {
    background: rgb(51,51,51);
}

QProgressBar {
    color: rgb(255,255,255);
    background-color: rgb(51,51,51);
    border: 2px;
    border-radius: 4px;
}
QProgressBar::chunk {
    border: 2px;
    border-radius: 4px;
    background-color: rgb(0,143,170);
}

QRadioButton {
    background: rgb(91,90,90);
    color: white;
}
QRadioButton::indicator {
    width: 10px;
    height: 10px;
    border-radius: 7px;
}
QRadioButton::indicator:checked {
    background-color: rgb(0,143,170);
    border: 2px solid rgb(51,51,51);
}
QRadioButton::indicator:unchecked {
    background-color: rgb(91,90,90);
    border: 2px solid rgb(51,51,51);
}

QCheckBox {
    color: rgb(255,255,255);
}
QCheckBox::indicator {
    width: 10px;
    height: 10px;
}
QCheckBox::indicator:unchecked {
    border: 2px solid rgb(51,51,51);
    background: rgb(91,90,90);
}
QCheckBox::indicator:unchecked:pressed {
    border: 2px solid rgb(51,51,51);
    background: rgb(0,143,170);
}
QCheckBox::indicator:checked {
    background-color: rgb(0,143,170);
    border: 2px solid rgb(51,51,51);
}
QCheckBox::indicator:checked:pressed {
    border: 2px solid rgb(51,51,51);
    background: rgb(91,90,90);
}

QScrollBar:vertical {
    background: rgb(51,51,51);
    width: 20px;
    margin: 0px 0px 0px 0px;
}
QScrollBar::handle:vertical {
    background: rgb(0,143,170);
}
QScrollBar::add-page:vertical {
    background: rgb(51,51,51);
}
QScrollBar::sub-page:vertical {
    background: rgb(51,51,51);
}

QGroupBox {
    border: 1px solid rgb(51,51,51);
    border-radius: 4px;
    color: white;
    background: rgb(91,90,90);
}

QSlider::groove:horizontal {
    height: 5px;
    background: rgb(51,51,51);
}
QSlider::handle:horizontal {
    background: rgb(0,143,170);
    width: 10px;
    margin: -8px 0;
}
QSlider::add-page:horizontal {
    background: rgb(51,51,51);
}
QSlider::sub-page:horizontal {
    background: rgb(51,51,51);
}

QSlider::groove:vertical {
    background: rgb(51,51,51);
    width: 5px;
}
QSlider::handle:vertical {
    height: 10px;
    background: rgb(0,143,170);
    margin: 0 -8px;
}
QSlider::add-page:vertical {
    background: rgb(51,51,51);
}
QSlider::sub-page:vertical {
    background: rgb(51,51,51);
}
